{
  "cues": [
    {
      "id": "c001",
      "startMs": 167,
      "endMs": 6500,
      "text": "大家好,现在我要用云南话来看给大家听。"
    },
    {
      "id": "c002",
      "startMs": 6500,
      "endMs": 9066,
      "text": "我叫做朱导。"
    },
    {
      "id": "c003",
      "startMs": 9067,
      "endMs": 15433,
      "text": "我是在泰国清迈出生的,算是华人。"
    },
    {
      "id": "c004",
      "startMs": 15434,
      "endMs": 19666,
      "text": "我爸我妈都是从云南国科到老面。"
    },
    {
      "id": "c005",
      "startMs": 19667,
      "endMs": 22066,
      "text": "后来又再到泰国。"
    },
    {
      "id": "c006",
      "startMs": 22067,
      "endMs": 26633,
      "text": "前来梅塞还有清迈那里。"
    },
    {
      "id": "c007",
      "startMs": 26634,
      "endMs": 29100,
      "text": "从小我们家就。"
    },
    {
      "id": "c008",
      "startMs": 29100,
      "endMs": 35833,
      "text": "我住到八岁的时候就是跟我爸我妈就搬到台湾来住了。"
    },
    {
      "id": "c009",
      "startMs": 35834,
      "endMs": 39133,
      "text": "现在我是住在桃园的古。"
    },
    {
      "id": "c010",
      "startMs": 39267,
      "endMs": 42533,
      "text": "那现在我家里还有三个人。"
    },
    {
      "id": "c011",
      "startMs": 42534,
      "endMs": 44500,
      "text": "我妈我哥还有我。"
    },
    {
      "id": "c012",
      "startMs": 44500,
      "endMs": 50266,
      "text": "我妈现在是在做那个人力总结公司里面是当翻译。"
    },
    {
      "id": "c013",
      "startMs": 50267,
      "endMs": 51533,
      "text": "台湾翻译。"
    },
    {
      "id": "c014",
      "startMs": 51534,
      "endMs": 56766,
      "text": "我哥们现在在晚上也在读中文。"
    },
    {
      "id": "c015",
      "startMs": 56767,
      "endMs": 58266,
      "text": "他跟我讲说。"
    },
    {
      "id": "c016",
      "startMs": 58267,
      "endMs": 60866,
      "text": "他现在有你朋友还单身。"
    },
    {
      "id": "c017",
      "startMs": 60867,
      "endMs": 63633,
      "text": "如果说有意思。"
    },
    {
      "id": "c018",
      "startMs": 63634,
      "endMs": 66200,
      "text": "可以跟我联络他。"
    },
    {
      "id": "c019",
      "startMs": 66200,
      "endMs": 71233,
      "text": "我们现在是在桃园发的社团。"
    },
    {
      "id": "c020",
      "startMs": 71234,
      "endMs": 72400,
      "text": "教台文。"
    },
    {
      "id": "c021",
      "startMs": 73634,
      "endMs": 77900,
      "text": "现在这次故事叫东南亚书典。"
    },
    {
      "id": "c022",
      "startMs": 77900,
      "endMs": 84200,
      "text": "我又在这个礼拜六晚上叫越南人讲中国话。"
    },
    {
      "id": "c023",
      "startMs": 84200,
      "endMs": 87866,
      "text": "那我介绍一下这个书店。"
    },
    {
      "id": "c024",
      "startMs": 87867,
      "endMs": 93500,
      "text": "它是可以来解一些东南亚的书。"
    },
    {
      "id": "c025",
      "startMs": 93500,
      "endMs": 96333,
      "text": "有时候越是会办一些活动。"
    },
    {
      "id": "c026",
      "startMs": 96334,
      "endMs": 99533,
      "text": "像是会做泰国的一些事物。"
    },
    {
      "id": "c027",
      "startMs": 99534,
      "endMs": 100733,
      "text": "越南的事物。"
    },
    {
      "id": "c028",
      "startMs": 100734,
      "endMs": 101933,
      "text": "印尼的事物。"
    },
    {
      "id": "c029",
      "startMs": 101934,
      "endMs": 103633,
      "text": "文化这种。"
    },
    {
      "id": "c030",
      "startMs": 103634,
      "endMs": 105733,
      "text": "如果大家有兴趣的话。"
    },
    {
      "id": "c031",
      "startMs": 105734,
      "endMs": 107966,
      "text": "可以来到我们去见面。"
    },
    {
      "id": "c032",
      "startMs": 108500,
      "endMs": 112433,
      "text": "这里的位置是爱做桃园和火车站。"
    },
    {
      "id": "c033",
      "startMs": 114034,
      "endMs": 116966,
      "text": "今天很谢谢大家来看。"
    },
    {
      "id": "c034",
      "startMs": 118000,
      "endMs": 121566,
      "text": "我朋友帮我们拍的影片。"
    },
    {
      "id": "c035",
      "startMs": 121567,
      "endMs": 123266,
      "text": "谢谢大家。"
    },
    {
      "id": "c036",
      "startMs": 123267,
      "endMs": 125200,
      "text": "有机会我们来见面。"
    },
    {
      "id": "c037",
      "startMs": 125200,
      "endMs": 125666,
      "text": "再见。"
    }
  ],
